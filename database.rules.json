  },
  "tads_pending": {
   ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
   "$id": {
    ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE' || !data.exists()",
    ".validate": "newData.hasChildren(['tid','title','at']) && newData.child('title').isString() && newData.child('title').val().length <= 150 && (!newData.child('desc').exists() || newData.child('desc').val().length <= 2000) && (!newData.child('img').exists() || newData.child('img').val().length <= 400000)"
   }
  },
  "notifs": {
   ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
   "$id": {
    ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE' || !data.exists()"
   }
  },
  "boards": {
   ".read": true,
   ".write": true
  },
  "tconf": {
