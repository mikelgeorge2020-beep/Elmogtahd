{
 "rules": {
  "teachers": {
   ".read": true,
   "$id": {
    ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE' || (!data.exists() && newData.child('approved').val() === false)"
   }
  },
  "sessions": {
   ".read": true,
   ".write": true
  },
  "students": {
   ".read": true,
   ".write": true
  },
  "files": {
   ".read": true,
   ".write": true
  },
  "online": {
   ".read": true,
   ".write": true
  },
  "attendance": {
   ".read": true,
   ".write": true
  },
  "payments": {
   ".read": true,
   ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'"
  },
